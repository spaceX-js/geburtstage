{
  "name": "geburtstage",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  // Seite, Skripte und Icon. Der Worker läuft zuerst, damit nur Angemeldete etwas sehen.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geburtstage-db",
      "database_id": "3f6cb949-5f3c-4a1e-876f-1008b6a63a84"
    }
  ],

  // stündlich: fällige Geburtstags-Erinnerungen verschicken (ab der eingestellten Uhrzeit, deutsche Zeit)
  "triggers": { "crons": ["0 * * * *"] },

  // Cloudflare Workers AI für Geschenkvorschläge (kostenloses Tageskontingent)
  "ai": { "binding": "AI" },

  "observability": { "enabled": true }
}
